# Copy this file to .env and fill in your own values
# .env is gitignored

# Required: used for gpt-4o-transcribe (STT baseline) and gpt-4o-mini (hotword curation / prompt A-B eval)
OPENAI_API_KEY=sk-your-key-here

# Hugging Face Hub token for downloading SASRBench-v1
HF_TOKEN=hf_xxxxxxxx

# Optional overrides (defaults shown)
# LLM_MODEL=gpt-4o-mini
# STT_BASELINE_MODEL=gpt-4o-transcribe
# WHISPER_MODEL=openai/whisper-large-v3-turbo
